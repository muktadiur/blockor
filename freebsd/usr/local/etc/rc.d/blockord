# PROVIDE: blockord
# REQUIRE: pf LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name="blockord"
rcvar="blockord_enable"

load_rc_config "$name"

: "${blockord_enable:=NO}"

start_cmd="/usr/local/bin/blockor start"
stop_cmd="/usr/local/bin/blockor stop"
restart_cmd="/usr/local/bin/blockor restart"
status_cmd="/usr/local/bin/blockor status"

run_rc_command "$1"
