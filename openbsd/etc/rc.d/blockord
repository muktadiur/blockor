daemon="/usr/local/libexec/blockor/blockord.sh"

. /etc/rc.d/rc.subr

pexp="/bin/sh ${daemon}"
rc_reload=NO

rc_start() {
    /usr/local/bin/blockor start >/dev/null 2>&1
}

rc_stop() {
    /usr/local/bin/blockor stop >/dev/null 2>&1
}

rc_check() {
    if [ -f /var/run/blockor/blockord.pid ]; then
        kill -0 "$(cat /var/run/blockor/blockord.pid)" 2>/dev/null
    else
        return 1
    fi
}

rc_cmd $1
