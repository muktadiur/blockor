#!/bin/sh
#
# Copyright (c) 2022-2026, Muktadiur Rahman <muktadiur@gmail.com>
# All rights reserved.

## version
version='0.2.0'

PATH=${PATH}:/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin

blockor_conf="/usr/local/etc/blockor.conf"
blockor_subr="/usr/local/libexec/blockor/blockor.subr"

# Refuse to source a config that any non-root user could have tampered with.
# (portable check: ls perm string, group-write at col 6 or other-write at col 9.
# ls is fine here - the path is fixed; find -perm +mode is not portable to OpenBSD.)
if [ -f "$blockor_conf" ]; then
    # shellcheck disable=SC2012
    _perm=$(ls -ld "$blockor_conf" 2>/dev/null | cut -c1-10)
    case "$_perm" in
    ?????w????|????????w?)
        printf 'blockor: error: %s is group/world writable; refusing to run\n' "$blockor_conf" >&2
        exit 1
        ;;
    esac
fi

if [ ! -r "$blockor_conf" ]; then
    printf 'blockor: error: %s not found\n' "$blockor_conf" >&2
    printf '  example config: /usr/local/share/examples/blockor/blockor.example.conf\n' >&2
    exit 1
fi

# shellcheck source=/dev/null
. "$blockor_conf"
# shellcheck source=../libexec/blockor/blockor.subr
. "${blockor_subr:-/usr/local/libexec/blockor/blockor.subr}"

OS=$(uname -s | tr '[:upper:]' '[:lower:]')

blockor_usage() {
    cat << EOF
blockor — protect FreeBSD and OpenBSD servers from brute-force attacks.

Usage:
  blockor <command> [args]

Commands:
  check         Check blockor.conf and the PF setup.
  start         Start the blockord daemon.
  stop          Stop the blockord daemon.
  restart       Restart the blockord daemon.
  reload        Restart the daemon, keeping the current ban list.
  enable        Start the blockord daemon at boot.
  disable       Do not start the blockord daemon at boot.
  add IP...     Block one or more addresses (permanent).
  remove IP...  Unblock one or more addresses.
  flush         Remove all entries from the block list.
  list          Show blocked addresses with failure count and time left.
  top           Show top offenders within the findtime window.
  test [log]    Dry run: show what would be banned from a log, change nothing.
  stats         Show ban counts and top offenders.
  report [IP..] Report banned IP(s) to AbuseIPDB (needs abuseipdb_key + curl).
  status        Show whether the daemon is running and enabled at boot.

Run "blockor --version" for version information.
EOF
    exit "${1:-1}"
}

permission_check() {
    if [ "$(id -u)" -ne 0 ]; then
        bo_err "must be run as root (use doas or sudo)"
        exit 1
    fi
}

blockor_version() {
    echo "blockor ${version}"
    exit 0
}

# True when the daemon recorded in the pid file is alive.
bo_running() {
    [ -f "$pid_file" ] || return 1
    _p=$(cat "$pid_file" 2>/dev/null)
    [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null
}

blockor_check() {
    _ok=1
    printf '%sChecking blockor configuration%s\n\n' "$C_B" "$C_R"

    if bo_pf_enabled; then
        bo_ok "pf enabled"
    else
        bo_bad "pf not enabled"
        printf '\n'
        bo_err "pf is not enabled; nothing can be blocked"
        exit 1
    fi

    if bo_pf_table_loaded; then
        bo_ok "table <$pf_table> loaded"
    else
        bo_bad "table <$pf_table> not loaded — nothing will be blocked"
        _ok=0
    fi

    if bo_pf_rule_loaded; then
        bo_ok "blocking rule present"
    else
        bo_bad "no loaded rule references <$pf_table>"
        _ok=0
    fi

    for f in ${auth_files:-$auth_file}; do
        if [ -r "$f" ]; then
            bo_ok "log readable  $f"
        else
            bo_bad "log not readable  $f"
            _ok=0
        fi
    done

    printf '\n'
    if [ "$_ok" -eq 1 ]; then
        printf '%sAll checks passed.%s\n' "$C_OK" "$C_R"
        exit 0
    fi

    cat <<EOF
Add this line near the top of your filter rules in /etc/pf.conf:

  include "/usr/local/etc/blockor.pf.conf"

then reload PF:  pfctl -f /etc/pf.conf
EOF
    exit 1
}

blockor_start() {
    if bo_running; then
        bo_warn "blockord is already running (pid $(cat "$pid_file" 2>/dev/null))"
        exit 1
    fi
    bo_ensure_dirs
    nohup "$blockord" >> "$blockor_log_file" 2>&1 &
    printf 'Started blockord (pid %s).\n' "$!"
}

blockor_stop() {
    if bo_running; then
        _p=$(cat "$pid_file" 2>/dev/null)
        kill -TERM "$_p" 2>/dev/null
        _i=0
        while kill -0 "$_p" 2>/dev/null && [ "$_i" -lt 10 ]; do
            sleep 1
            _i=$((_i + 1))
        done
        kill -0 "$_p" 2>/dev/null && kill -KILL "$_p" 2>/dev/null
        rm -f "$pid_file" "$fifo_file"
        printf 'Stopped blockord.\n'
    else
        rm -f "$pid_file" "$fifo_file"
        bo_warn "blockord is not running"
    fi
}

blockor_restart() {
    blockor_stop
    blockor_start
    exit 0
}

# State (bans/failures) lives on disk, so a restart preserves the ban list.
blockor_reload() {
    blockor_stop
    blockor_start
    exit 0
}

blockor_add() {
    bo_ensure_dirs
    bo_load_whitelist
    if ! bo_pf_table_loaded; then
        bo_warn "table <$pf_table> not loaded — run 'blockor check'"
    fi
    _blocked=''
    _skipped=''
    _n=0
    for arg in "$@"; do
        if ! bo_valid_ip "$arg"; then
            bo_err "invalid IP address: $arg"
            continue
        fi
        if bo_is_whitelisted "$arg"; then
            _skipped="${_skipped:+$_skipped, }$arg"
            continue
        fi
        # Manual adds are permanent (bantime 0); the admin chose them explicitly.
        if bo_ban "$arg" 0 0; then
            _blocked="${_blocked:+$_blocked, }$arg"
            _n=$((_n + 1))
        fi
    done
    [ -n "$_blocked" ] && printf 'Blocked %d address(es): %s\n' "$_n" "$_blocked"
    [ -n "$_skipped" ] && printf 'Skipped (whitelisted): %s\n' "$_skipped"
    exit 0
}

blockor_remove() {
    bo_ensure_dirs
    _removed=''
    _n=0
    for arg in "$@"; do
        if ! bo_valid_ip "$arg"; then
            bo_err "invalid IP address: $arg"
            continue
        fi
        bo_unban "$arg"
        _removed="${_removed:+$_removed, }$arg"
        _n=$((_n + 1))
    done
    [ -n "$_removed" ] && printf 'Unblocked %d address(es): %s\n' "$_n" "$_removed"
    exit 0
}

blockor_flush() {
    _n=$(pfctl -t "$pf_table" -T show 2>/dev/null | grep -c .)
    pfctl -t "$pf_table" -q -T flush >/dev/null 2>&1
    : > "$bans_file" 2>/dev/null
    : > "$failures_file" 2>/dev/null
    printf 'Flushed — removed %s address(es) from the block list.\n' "$_n"
    exit 0
}

blockor_list() {
    _total=$(pfctl -t "$pf_table" -T show 2>/dev/null | grep -c .)
    if [ "$_total" -eq 0 ]; then
        printf 'No addresses blocked.\n'
        exit 0
    fi
    printf '%s address(es) blocked\n\n' "$_total"
    if [ -s "$bans_file" ]; then
        _now=$(bo_now)
        printf '%s%-40s %8s   %s%s\n' "$C_B" "ADDRESS" "FAILURES" "EXPIRES IN" "$C_R"
        while read -r _epoch _ip _cnt _bt; do
            [ -n "$_ip" ] || continue
            if [ "${_bt:-0}" -le 0 ] 2>/dev/null; then
                _rem="permanent"
            else
                _rem=$(bo_human_time "$(( _bt - (_now - _epoch) ))")
            fi
            [ "${_cnt:-0}" -eq 0 ] 2>/dev/null && _cnt='-'
            printf '%-40s %8s   %s\n' "$_ip" "$_cnt" "$_rem"
        done < "$bans_file"
    else
        pfctl -t "$pf_table" -T show 2>/dev/null
    fi
    exit 0
}

blockor_top() {
    if [ ! -s "$failures_file" ]; then
        printf 'No recent failures.\n'
        exit 0
    fi
    _cutoff=$(( $(bo_now) - findtime ))
    printf '%sTop offenders — last %s%s\n\n' "$C_B" "$(bo_human_time "$findtime")" "$C_R"
    printf '%s%8s   %s%s\n' "$C_B" "FAILURES" "ADDRESS" "$C_R"
    awk -v cut="$_cutoff" '$1 >= cut {print $2}' "$failures_file" \
        | sort | uniq -c | sort -nr | head -20 \
        | while read -r _c _i; do
            printf '%8s   %s\n' "$_c" "$_i"
        done
    exit 0
}

blockor_test() {
    _file=${1:-$auth_file}
    if [ ! -r "$_file" ]; then
        bo_err "cannot read log file: $_file"
        exit 1
    fi
    bo_load_whitelist
    printf '%sDry run%s — %s\n' "$C_B" "$C_R" "$_file"
    printf 'Would ban at >= %s failures (whole-file totals; no changes made).\n\n' "$max_tolerance"
    printf '%s  %-16s %8s   %s%s\n' "$C_B" "VERDICT" "FAILS" "ADDRESS" "$C_R"
    _counts=$(bo_dryrun_counts "$_file")
    _would=0
    _total=0
    while read -r _c _ip; do
        [ -n "$_ip" ] || continue
        _total=$((_total + 1))
        if bo_is_whitelisted "$_ip"; then
            _v="skip (whitelist)"
        elif [ "$_c" -ge "$max_tolerance" ]; then
            _v="BAN"
            _would=$((_would + 1))
        else
            _v="no"
        fi
        printf '  %-16s %8s   %s\n' "$_v" "$_c" "$_ip"
    done <<EOF
$_counts
EOF
    if [ "$_total" -eq 0 ]; then
        printf 'No matching failures found.\n'
    else
        printf '\n%s%d of %d address(es) would be banned.%s\n' "$C_B" "$_would" "$_total" "$C_R"
    fi
    exit 0
}

blockor_stats() {
    _now=$(bo_now)
    _blocked=$(pfctl -t "$pf_table" -T show 2>/dev/null | grep -c .)
    printf '%sblockor statistics%s\n\n' "$C_B" "$C_R"
    printf '  %-20s %s\n' "Currently blocked" "$_blocked"
    printf '  %-20s %s\n' "Bans (last 24h)" "$(bo_bans_since $((_now - 86400)))"
    printf '  %-20s %s\n' "Bans (last 7 days)" "$(bo_bans_since $((_now - 604800)))"
    printf '  %-20s %s\n' "Bans (recorded)" "$(bo_history_total)"

    _top=$(bo_top_offenders 10)
    [ -n "$_top" ] || { exit 0; }
    printf '\n%sTop offenders (all time)%s\n' "$C_B" "$C_R"
    if command -v geoiplookup >/dev/null 2>&1; then
        printf '%s%6s   %-24s %s%s\n' "$C_B" "BANS" "COUNTRY" "ADDRESS" "$C_R"
        printf '%s\n' "$_top" | while read -r _c _ip; do
            [ -n "$_ip" ] && printf '%6s   %-24s %s\n' "$_c" "$(bo_country "$_ip")" "$_ip"
        done
    else
        printf '%s%6s   %s%s\n' "$C_B" "BANS" "ADDRESS" "$C_R"
        printf '%s\n' "$_top" | while read -r _c _ip; do
            [ -n "$_ip" ] && printf '%6s   %s\n' "$_c" "$_ip"
        done
    fi
    exit 0
}

blockor_report() {
    if [ -z "$abuseipdb_key" ]; then
        bo_err "abuseipdb_key is not set in $blockor_conf"
        exit 1
    fi
    if ! command -v curl >/dev/null 2>&1; then
        bo_err "curl is required for AbuseIPDB reporting (pkg install curl)"
        exit 1
    fi
    _targets=$*
    [ -n "$_targets" ] || _targets=$(pfctl -t "$pf_table" -T show 2>/dev/null)
    _n=0
    for _ip in $_targets; do
        if ! bo_valid_ip "$_ip"; then
            bo_err "invalid IP address: $_ip"
            continue
        fi
        if bo_report_abuseipdb "$_ip" "blockor: brute-force attempts (FreeBSD/OpenBSD)"; then
            _n=$((_n + 1))
        fi
    done
    printf 'Reported %d address(es) to AbuseIPDB.\n' "$_n"
    exit 0
}

freebsd_boot_state() {
    RC=$(grep blockord_enable /etc/rc.conf 2>/dev/null | cut -d "=" -f2 | tr '[:upper:]' '[:lower:]')
    case "$RC" in
    *yes*) echo "enabled at boot" ;;
    *)     echo "disabled at boot" ;;
    esac
}

openbsd_boot_state() {
    if [ -f /etc/rc.conf.local ] && awk '/pkg_scripts/ && /blockord/' /etc/rc.conf.local | grep -q blockord; then
        echo "enabled at boot"
    else
        echo "disabled at boot"
    fi
}

blockor_status() {
    if [ "$OS" = 'openbsd' ]; then
        _boot=$(openbsd_boot_state)
    else
        _boot=$(freebsd_boot_state)
    fi
    if bo_running; then
        printf '%s\342\227\217%s  blockord — running   (%s, pid %s)\n' \
            "$C_OK" "$C_R" "$_boot" "$(cat "$pid_file" 2>/dev/null)"
    else
        printf '%s\342\227\217%s  blockord — stopped   (%s)\n' \
            "$C_ERR" "$C_R" "$_boot"
    fi
    exit 0
}

blockor_enable() {
    if [ "$OS" = 'openbsd' ]; then
        rcctl enable blockord
    else
        sysrc blockord_enable="YES" >/dev/null
    fi
    printf 'blockord will start at boot.\n'
}

blockor_disable() {
    if [ "$OS" = 'openbsd' ]; then
        rcctl disable blockord
    else
        sysrc blockord_enable="NO" >/dev/null
    fi
    printf 'blockord will not start at boot.\n'
}

[ $# -lt 1 ] && blockor_usage

CMD=$1
shift

case ${CMD} in
version|-v|--version)
    blockor_version
    ;;
help|-h|--help)
    blockor_usage 0
    ;;
check|--check)
    permission_check
    blockor_check
    ;;
start|--start)
    permission_check
    blockor_start
    exit 0
    ;;
stop|--stop)
    permission_check
    blockor_stop
    exit 0
    ;;
restart|--restart)
    permission_check
    blockor_restart
    ;;
reload)
    permission_check
    blockor_reload
    ;;
add|-a|--add)
    permission_check
    [ $# -lt 1 ] && blockor_usage
    blockor_add "$@"
    ;;
remove|-r|--remove)
    permission_check
    [ $# -lt 1 ] && blockor_usage
    blockor_remove "$@"
    ;;
flush|-f|--flush)
    permission_check
    blockor_flush
    ;;
list|-l|--list)
    permission_check
    blockor_list
    ;;
top|-t|--top)
    permission_check
    blockor_top
    ;;
test|--test|--dry-run)
    permission_check
    blockor_test "$1"
    ;;
stats|--stats)
    permission_check
    blockor_stats
    ;;
report|--report-abuseipdb)
    permission_check
    blockor_report "$@"
    ;;
status|-s|--status)
    permission_check
    blockor_status
    ;;
enable|-e|--enable)
    permission_check
    blockor_enable
    ;;
disable|-d|--disable)
    permission_check
    blockor_disable
    ;;
*)
    blockor_usage
    ;;
esac
