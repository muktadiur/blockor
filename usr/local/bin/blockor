#!/bin/sh
#
# Copyright (c) 2022-2026, Muktadiur Rahman <muktadiur@gmail.com>
# All rights reserved.

## version
version='0.2.0'

PATH=${PATH}:/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin

blockor_conf="/usr/local/etc/blockor.conf"
blockor_subr="/usr/local/libexec/blockor/blockor.subr"

# Refuse to source a config that any non-root user could have tampered with.
if [ -f "$blockor_conf" ] && [ -n "$(find "$blockor_conf" -perm +022 2>/dev/null)" ]; then
    echo "blockor(insecure permissions on $blockor_conf; must not be group/world writable)" >&2
    exit 1
fi

if [ ! -r "$blockor_conf" ]; then
    echo "blockor($blockor_conf not found)"
    echo "example: /usr/local/share/examples/blockor/blockor.example.conf"
    exit 1
fi

. "$blockor_conf"
. "${blockor_subr:-/usr/local/libexec/blockor/blockor.subr}"

OS=$(uname -s | tr '[:upper:]' '[:lower:]')

blockor_usage() {
    cat << EOF
Blockor protects FreeBSD, OpenBSD servers from brute-force attacks.
Usage:
  blockor command [args]
Available Commands:
  check         Check blockor.conf and the PF setup, show config for /etc/pf.conf.
  start         Start the blockord daemon.
  stop          Stop the blockord daemon.
  restart       Restart the blockord daemon.
  reload        Restart the daemon, keeping the current ban list.
  enable        Start the blockord daemon at boot.
  disable       Do not start the blockord daemon at boot.
  add           Add IP(s) to the blocked list (permanent).
  remove        Remove IP(s) from the blocked list.
  flush         Remove all entries from the blocked list.
  list          Show blocked IPs with failure count and time left.
  top           Show top offenders seen within the findtime window.
  status        Running or Stopped (enabled|disabled).
Use "blockor -v|--version" for version information.
EOF
    exit 1
}

permission_check() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "blockor(permission denied). root|doas|sudo required"
        exit 1
    fi
}

blockor_version() {
    echo "blockor(${version})"
    exit 0
}

# True when the daemon recorded in the pid file is alive.
bo_running() {
    [ -f "$pid_file" ] || return 1
    _p=$(cat "$pid_file" 2>/dev/null)
    [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null
}

blockor_check() {
    _ok=1

    if ! bo_pf_enabled; then
        echo "blockor(pf not enabled)"
        exit 1
    fi

    if bo_pf_table_loaded; then
        echo "blockor(pf table <$pf_table> ok)"
    else
        echo "blockor(WARNING: pf table <$pf_table> not loaded - nothing will be blocked)"
        _ok=0
    fi

    if bo_pf_rule_loaded; then
        echo "blockor(pf rule ok)"
    else
        echo "blockor(WARNING: no loaded rule references <$pf_table>)"
        _ok=0
    fi

    for f in ${auth_files:-$auth_file}; do
        if [ ! -r "$f" ]; then
            echo "blockor(WARNING: log file not readable: $f)"
            _ok=0
        fi
    done

    if [ "$_ok" -eq 1 ]; then
        echo "blockor(ok)"
    else
        cat <<EOF

Add to /etc/pf.conf and run: pfctl -f /etc/pf.conf
table <blockor> persist
block drop in quick on egress from <blockor> to any
EOF
    fi
    exit 0
}

blockor_start() {
    if bo_running; then
        echo 'blockord(already running)'
        exit 1
    fi
    bo_ensure_dirs
    nohup "$blockord" >> "$blockor_log_file" 2>&1 &
    echo 'blockord(running)'
}

blockor_stop() {
    if bo_running; then
        _p=$(cat "$pid_file" 2>/dev/null)
        kill -TERM "$_p" 2>/dev/null
        _i=0
        while kill -0 "$_p" 2>/dev/null && [ "$_i" -lt 10 ]; do
            sleep 1
            _i=$((_i + 1))
        done
        kill -0 "$_p" 2>/dev/null && kill -KILL "$_p" 2>/dev/null
    fi
    rm -f "$pid_file" "$fifo_file"
    echo 'blockord(stopped)'
}

blockor_restart() {
    blockor_stop
    blockor_start
    exit 0
}

# State (bans/failures) lives on disk, so a restart preserves the ban list.
blockor_reload() {
    if bo_running; then
        blockor_stop
        blockor_start
    else
        echo 'blockord(not running)'
        blockor_start
    fi
    exit 0
}

blockor_add() {
    bo_ensure_dirs
    bo_load_whitelist
    if ! bo_pf_table_loaded; then
        echo "blockor(WARNING: pf table <$pf_table> not loaded - run 'blockor check')"
    fi
    _added=0
    for arg in "$@"; do
        if ! bo_valid_ip "$arg"; then
            echo "blockor(invalid IP: $arg)"
            continue
        fi
        if bo_is_whitelisted "$arg"; then
            echo "blockor(whitelisted. skipped. $arg)"
            continue
        fi
        # Manual adds are permanent (bantime 0); the admin chose them explicitly.
        if bo_ban "$arg" 0 0; then
            _added=$((_added + 1))
        fi
    done
    [ "$_added" -gt 0 ] && echo 'blockor(ok)'
    exit 0
}

blockor_remove() {
    bo_ensure_dirs
    for arg in "$@"; do
        if ! bo_valid_ip "$arg"; then
            echo "blockor(invalid IP: $arg)"
            continue
        fi
        bo_unban "$arg"
    done
    echo 'blockor(removed)'
    exit 0
}

blockor_flush() {
    pfctl -t "$pf_table" -q -T flush >/dev/null 2>&1
    : > "$bans_file" 2>/dev/null
    : > "$failures_file" 2>/dev/null
    echo 'blockor(flushed)'
    exit 0
}

blockor_list() {
    _total=$(pfctl -t "$pf_table" -T show 2>/dev/null | grep -c .)
    echo "Total ${_total} IP(s) blocked"
    if [ -s "$bans_file" ]; then
        _now=$(bo_now)
        printf '%-42s %6s %12s\n' "IP" "FAILS" "EXPIRES_IN"
        while read -r _epoch _ip _cnt _bt; do
            [ -n "$_ip" ] || continue
            if [ "${_bt:-0}" -le 0 ] 2>/dev/null; then
                _rem="permanent"
            else
                _left=$(( _bt - (_now - _epoch) ))
                [ "$_left" -lt 0 ] && _left=0
                _rem="${_left}s"
            fi
            printf '%-42s %6s %12s\n' "$_ip" "$_cnt" "$_rem"
        done < "$bans_file"
    else
        pfctl -t "$pf_table" -T show 2>/dev/null
    fi
    exit 0
}

blockor_top() {
    if [ ! -s "$failures_file" ]; then
        echo "No recent failures"
        exit 0
    fi
    _cutoff=$(( $(bo_now) - findtime ))
    echo "Top offenders (last ${findtime}s):"
    echo "count  IP"
    awk -v cut="$_cutoff" '$1 >= cut {print $2}' "$failures_file" \
        | sort | uniq -c | sort -nr | head -20
    exit 0
}

freebsd_status() {
    RC=$(grep blockord_enable /etc/rc.conf 2>/dev/null | cut -d "=" -f2 | tr '[:upper:]' '[:lower:]')
    case "$RC" in
    *yes*)
        echo "blockord(${1}.enabled)"
        ;;
    *)
        echo "blockord(${1}.disabled)"
        ;;
    esac
}

openbsd_status() {
    if [ ! -f /etc/rc.conf.local ]; then
        echo "blockord(${1}.disabled)"
        exit 1
    fi
    RC_LOCAL=$(awk '/pkg_scripts/ && /blockord/' /etc/rc.conf.local)
    case "$RC_LOCAL" in
    *blockord*)
        echo "blockord(${1}.enabled)"
        ;;
    *)
        echo "blockord(${1}.disabled)"
        ;;
    esac
}

blockor_status() {
    if bo_running; then
        _state='running'
    else
        _state='stopped'
    fi
    if [ "$OS" = 'openbsd' ]; then
        openbsd_status "$_state"
    else
        freebsd_status "$_state"
    fi
    exit 0
}

blockor_enable() {
    if [ "$OS" = 'openbsd' ]; then
        rcctl enable blockord
    else
        sysrc blockord_enable="YES"
    fi
    echo 'blockord(enabled)'
}

blockor_disable() {
    if [ "$OS" = 'openbsd' ]; then
        rcctl disable blockord
    else
        sysrc blockord_enable="NO"
    fi
    echo 'blockord(disabled)'
}

[ $# -lt 1 ] && blockor_usage

CMD=$1
shift

case ${CMD} in
version|-v|--version)
    blockor_version
    ;;
help|-h|--help)
    blockor_usage
    ;;
check|--check)
    permission_check
    blockor_check
    ;;
start|--start)
    permission_check
    blockor_start
    exit 0
    ;;
stop|--stop)
    permission_check
    blockor_stop
    exit 0
    ;;
restart|--restart)
    permission_check
    blockor_restart
    ;;
reload)
    permission_check
    blockor_reload
    ;;
add|-a|--add)
    permission_check
    [ $# -lt 1 ] && blockor_usage
    blockor_add "$@"
    ;;
remove|-r|--remove)
    permission_check
    [ $# -lt 1 ] && blockor_usage
    blockor_remove "$@"
    ;;
flush|-f|--flush)
    permission_check
    blockor_flush
    ;;
list|-l|--list)
    permission_check
    blockor_list
    ;;
top|-t|--top)
    permission_check
    blockor_top
    ;;
status|-s|--status)
    permission_check
    blockor_status
    ;;
enable|-e|--enable)
    permission_check
    blockor_enable
    ;;
disable|-d|--disable)
    permission_check
    blockor_disable
    ;;
*)
    blockor_usage
    ;;
esac
