#!/bin/sh
#
# Copyright (c) 2022-2026, Muktadiur Rahman <muktadiur@gmail.com>
# All rights reserved.
#
# blockor.subr - shared library for the blockor CLI and the blockord daemon.
# Sourced by both. POSIX sh only. Source AFTER /usr/local/etc/blockor.conf so
# that user settings take precedence over the defaults applied here.

# ---- defaults (only applied when not already set by blockor.conf) ----
: "${blockord:=/usr/local/libexec/blockor/blockord.sh}"
: "${blockor:=/usr/local/bin/blockor}"
: "${db_dir:=/var/db/blockor}"
: "${run_dir:=/var/run/blockor}"
: "${blockor_log_file:=/var/log/blockord.log}"
: "${auth_file:=/var/log/auth.log}"
: "${max_tolerance:=10}"
: "${findtime:=600}"
: "${bantime:=3600}"
: "${expire_interval:=60}"
: "${blockor_whitelist:=}"
: "${notify_syslog:=YES}"
: "${notify_email:=}"
: "${notify_command:=}"
: "${protect_active_ssh:=YES}"
: "${ssh_port:=22}"
: "${pf_table:=blockor}"
: "${pf_whitelist_table:=blockor_white}"
: "${search_pattern:=PAM: Authentication error|Failed password|Invalid user|Unable to negotiate with|Bad protocol version identification|Disconnected from authenticating user root}"

failures_file="${db_dir}/failures"
bans_file="${db_dir}/bans"
# pid_file/fifo_file are part of this library's interface, used by the CLI and
# daemon that source it (so they look unused when this file is linted alone).
# shellcheck disable=SC2034
pid_file="${run_dir}/blockord.pid"
# shellcheck disable=SC2034
fifo_file="${run_dir}/blockord.fifo"

# ---- address matching ----
# IPv4 with octet validation (0-255), and a canonical IPv6 matcher. Every IPv6
# alternative either has the full 7 colons or contains "::", so a syslog time
# such as "01:44:30" (only two colons, no "::") is never mistaken for an address.
BO_IPV4_RE='((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])'
BO_IPV6_RE='([0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,7}:|([0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,5}(:[0-9A-Fa-f]{1,4}){1,2}|([0-9A-Fa-f]{1,4}:){1,4}(:[0-9A-Fa-f]{1,4}){1,3}|([0-9A-Fa-f]{1,4}:){1,3}(:[0-9A-Fa-f]{1,4}){1,4}|([0-9A-Fa-f]{1,4}:){1,2}(:[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(:[0-9A-Fa-f]{1,4}){1,6}|:((:[0-9A-Fa-f]{1,4}){1,7}|:)'
BO_IP_RE="${BO_IPV4_RE}|${BO_IPV6_RE}"

# ---- output helpers ----
# Color is emitted only on an interactive terminal and never when NO_COLOR is
# set or TERM is dumb, so pipes, logs and the daemon stay plain text. stdout and
# stderr are gated independently (C_* for stdout, E_* for stderr diagnostics).
# C_WARN/C_B are used by the CLI that sources this library.
# shellcheck disable=SC2034
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
    C_OK=$(printf '\033[32m'); C_ERR=$(printf '\033[31m'); C_WARN=$(printf '\033[33m')
    C_B=$(printf '\033[1m'); C_R=$(printf '\033[0m')
else
    C_OK=''; C_ERR=''; C_WARN=''; C_B=''; C_R=''
fi
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
    E_ERR=$(printf '\033[31m'); E_WARN=$(printf '\033[33m'); E_R=$(printf '\033[0m')
else
    E_ERR=''; E_WARN=''; E_R=''
fi

bo_err()  { printf '%sblockor: error:%s %s\n'   "$E_ERR"  "$E_R" "$*" >&2; }
bo_warn() { printf '%sblockor: warning:%s %s\n' "$E_WARN" "$E_R" "$*" >&2; }
bo_ok()   { printf '  %s\342\234\223%s  %s\n' "$C_OK"  "$C_R" "$*"; }
bo_bad()  { printf '  %s\342\234\227%s  %s\n' "$C_ERR" "$C_R" "$*"; }

# Render a number of seconds as a compact human duration (e.g. 45s, 52m, 1h, 3d2h).
bo_human_time() {
    _s=$1
    [ "$_s" -lt 0 ] 2>/dev/null && _s=0
    if [ "$_s" -lt 60 ]; then printf '%ds' "$_s"; return; fi
    if [ "$_s" -lt 3600 ]; then printf '%dm' "$(( _s / 60 ))"; return; fi
    if [ "$_s" -lt 86400 ]; then
        _h=$(( _s / 3600 )); _m=$(( (_s % 3600) / 60 ))
        if [ "$_m" -eq 0 ]; then printf '%dh' "$_h"; else printf '%dh%dm' "$_h" "$_m"; fi
        return
    fi
    _d=$(( _s / 86400 )); _h=$(( (_s % 86400) / 3600 ))
    if [ "$_h" -eq 0 ]; then printf '%dd' "$_d"; else printf '%dd%dh' "$_d" "$_h"; fi
}

bo_now() {
    date -u +%s
}

# Create state/run directories and the data files with safe permissions.
bo_ensure_dirs() {
    [ -d "$db_dir" ] || mkdir -p "$db_dir"
    [ -d "$run_dir" ] || mkdir -p "$run_dir"
    chmod 700 "$db_dir" "$run_dir" 2>/dev/null
    [ -f "$failures_file" ] || : > "$failures_file"
    [ -f "$bans_file" ] || : > "$bans_file"
    chmod 600 "$failures_file" "$bans_file" 2>/dev/null
}

# Pull the source address out of a log line. Strips a leading BSD syslog
# timestamp first, then takes the last IPv4/IPv6 token on the line (the source
# address is consistently near the end of sshd/PAM messages).
bo_extract_ip() {
    printf '%s\n' "$1" \
        | sed -E 's/^[A-Za-z]{3} +[0-9]+ [0-9]{2}:[0-9]{2}:[0-9]{2} //' \
        | grep -oE "$BO_IP_RE" \
        | tail -n 1
}

# True if the argument is exactly one valid IPv4 or IPv6 address.
bo_valid_ip() {
    printf '%s' "$1" | grep -qE "^(${BO_IP_RE})\$"
}

bo_pf_enabled() {
    [ -c /dev/pf ]
}

# True if the <blockor> table exists in the running ruleset.
bo_pf_table_loaded() {
    pfctl -t "$pf_table" -T show >/dev/null 2>&1
}

# True if some loaded rule references the <blockor> table.
bo_pf_rule_loaded() {
    pfctl -sr 2>/dev/null | grep -q "$pf_table"
}

# Load the configured whitelist (IPs and/or CIDRs, v4 and v6) into a PF table so
# membership tests get longest-prefix matching for free.
bo_load_whitelist() {
    [ -n "$blockor_whitelist" ] || return 0
    pfctl -t "$pf_whitelist_table" -T flush >/dev/null 2>&1
    # shellcheck disable=SC2086
    pfctl -t "$pf_whitelist_table" -q -T add $blockor_whitelist >/dev/null 2>&1
    return 0
}

# True if the address is whitelisted. Exact text match first (works with no PF
# state), then a PF table test which also matches CIDR ranges.
bo_is_whitelisted() {
    _ip=$1
    for _w in $blockor_whitelist; do
        [ "$_ip" = "$_w" ] && return 0
    done
    if [ -n "$blockor_whitelist" ]; then
        pfctl -t "$pf_whitelist_table" -T test "$_ip" >/dev/null 2>&1 && return 0
    fi
    return 1
}

bo_log() {
    printf '%s: %s\n' "$(date -u)" "$*" >> "$blockor_log_file" 2>/dev/null
}

# Fan out a ban/unban event to the configured notifiers (all opt-in).
bo_notify() {
    _action=$1
    _ip=$2
    _count=${3:-}
    _msg="blockor: ${_action} ${_ip}"
    [ -n "$_count" ] && _msg="${_msg} (${_count} failures in ${findtime}s)"
    case "$notify_syslog" in
        [Yy][Ee][Ss]|1) command -v logger >/dev/null 2>&1 && logger -t blockor "$_msg" 2>/dev/null ;;
    esac
    if [ -n "$notify_email" ] && command -v mail >/dev/null 2>&1; then
        printf '%s\n' "$_msg" | mail -s "[blockor] ${_action} ${_ip}" "$notify_email" 2>/dev/null
    fi
    if [ -n "$notify_command" ]; then
        "$notify_command" "$_action" "$_ip" "$_count" 2>/dev/null
    fi
    return 0
}

# True if the address is currently in the <blockor> table.
bo_is_banned() {
    pfctl -t "$pf_table" -T test "$1" >/dev/null 2>&1
}

# Drop every line of $1 whose second field equals address $2 (exact, no regex).
bo_remove_from_file() {
    _f=$1
    _ip=$2
    [ -f "$_f" ] || return 0
    _tmp="${_f}.tmp.$$"
    if awk -v ip="$_ip" '$2 != ip' "$_f" > "$_tmp" 2>/dev/null; then
        mv "$_tmp" "$_f"
    else
        rm -f "$_tmp"
    fi
}

# Ban an address: $1=ip [$2=failure count] [$3=bantime seconds, 0=permanent].
# No-op (success) if the address is already banned, so it is safe to call often.
bo_ban() {
    _ip=$1
    _bcount=${2:-0}
    _bt=${3:-$bantime}
    bo_is_banned "$_ip" && return 0
    pfctl -t "$pf_table" -q -T add "$_ip" >/dev/null 2>&1 || return 1
    printf '%s %s %s %s\n' "$(bo_now)" "$_ip" "$_bcount" "$_bt" >> "$bans_file"
    bo_log "banned ${_ip} (${_bcount} failures, bantime=${_bt}s)"
    bo_notify ban "$_ip" "$_bcount"
    return 0
}

# Remove an address from the table and forget its history.
bo_unban() {
    _ip=$1
    pfctl -t "$pf_table" -q -T delete "$_ip" >/dev/null 2>&1
    bo_remove_from_file "$bans_file" "$_ip"
    bo_remove_from_file "$failures_file" "$_ip"
    bo_log "unbanned ${_ip}"
    bo_notify unban "$_ip"
    return 0
}

bo_record_failure() {
    printf '%s %s\n' "$(bo_now)" "$1" >> "$failures_file"
}

# Number of recorded failures for $1 inside the findtime window.
bo_window_count() {
    _ip=$1
    _cutoff=$(( $(bo_now) - findtime ))
    [ -f "$failures_file" ] || { echo 0; return 0; }
    awk -v ip="$_ip" -v cut="$_cutoff" '$1 >= cut && $2 == ip { n++ } END { print n+0 }' "$failures_file"
}

# Drop failure records older than the findtime window. Keeps the file bounded.
bo_prune_failures() {
    [ -f "$failures_file" ] || return 0
    _cutoff=$(( $(bo_now) - findtime ))
    _tmp="${failures_file}.tmp.$$"
    if awk -v cut="$_cutoff" '$1 >= cut' "$failures_file" > "$_tmp" 2>/dev/null; then
        mv "$_tmp" "$failures_file"
    else
        rm -f "$_tmp"
    fi
}

# Release bans whose bantime has elapsed (bantime 0 = permanent, never expires).
bo_expire_bans() {
    [ -f "$bans_file" ] || return 0
    _now=$(bo_now)
    _tmp="${bans_file}.tmp.$$"
    : > "$_tmp"
    while read -r _epoch _ip _cnt _bt; do
        [ -n "$_ip" ] || continue
        if [ "${_bt:-0}" -gt 0 ] 2>/dev/null && [ $(( _now - _epoch )) -gt "$_bt" ]; then
            pfctl -t "$pf_table" -q -T delete "$_ip" >/dev/null 2>&1
            bo_remove_from_file "$failures_file" "$_ip"
            bo_log "expired ${_ip} (bantime ${_bt}s)"
            bo_notify unban "$_ip"
        else
            printf '%s %s %s %s\n' "$_epoch" "$_ip" "$_cnt" "$_bt" >> "$_tmp"
        fi
    done < "$bans_file"
    mv "$_tmp" "$bans_file"
}

# Re-apply persisted bans to PF at daemon start, dropping any already expired.
# This is what lets bans survive a reboot.
bo_restore_bans() {
    [ -f "$bans_file" ] || return 0
    _now=$(bo_now)
    _tmp="${bans_file}.tmp.$$"
    : > "$_tmp"
    while read -r _epoch _ip _cnt _bt; do
        [ -n "$_ip" ] || continue
        if [ "${_bt:-0}" -gt 0 ] 2>/dev/null && [ $(( _now - _epoch )) -gt "$_bt" ]; then
            continue
        fi
        pfctl -t "$pf_table" -q -T add "$_ip" >/dev/null 2>&1
        printf '%s %s %s %s\n' "$_epoch" "$_ip" "$_cnt" "$_bt" >> "$_tmp"
    done < "$bans_file"
    mv "$_tmp" "$bans_file"
}

# True if $1 currently has an established connection to the local SSH port.
# Best-effort lock-out guard: returns 1 (not active) when it cannot tell, so it
# never interferes with normal banning. Disabled when protect_active_ssh is off.
bo_is_active_ssh_peer() {
    _ip=$1
    case "$protect_active_ssh" in
        [Yy]*|1) ;;
        *) return 1 ;;
    esac
    netstat -n -p tcp 2>/dev/null | awk -v ip="$_ip" -v lport=".${ssh_port}" '
        /ESTABLISHED/ {
            local = $4; foreign = $5
            if (substr(local, length(local) - length(lport) + 1) == lport) {
                sub(/\.[0-9]+$/, "", foreign)
                if (foreign == ip) found = 1
            }
        }
        END { exit(found ? 0 : 1) }
    '
}

# Report "<count> <ip>" lines (most failures first) for a log file, using the
# same pattern matching and IP extraction as live detection. No side effects;
# used by `blockor test` (dry run).
bo_dryrun_counts() {
    grep -E "$search_pattern" "$1" 2>/dev/null \
        | while IFS= read -r _l; do bo_extract_ip "$_l"; done \
        | grep -v '^$' | sort | uniq -c | sort -rn
}

# Handle one raw log line: match pattern, extract IP, skip whitelisted/already
# banned, record the failure, and ban once the window count crosses the limit.
bo_process_line() {
    _line=$1
    printf '%s\n' "$_line" | grep -qE "$search_pattern" || return 0
    _ip=$(bo_extract_ip "$_line")
    [ -n "$_ip" ] || return 0
    bo_is_whitelisted "$_ip" && return 0
    bo_is_banned "$_ip" && return 0
    bo_record_failure "$_ip"
    _count=$(bo_window_count "$_ip")
    if [ "$_count" -ge "$max_tolerance" ]; then
        # Never auto-ban an address with a live SSH session (lock-out guard).
        if bo_is_active_ssh_peer "$_ip"; then
            bo_log "skipped ban of ${_ip} (active SSH session)"
            return 0
        fi
        bo_ban "$_ip" "$_count"
    fi
    return 0
}
